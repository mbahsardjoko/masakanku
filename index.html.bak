        .navbar { background: #c0392b !important; box-shadow: 0 2px 15px rgba(0,0,0,0.15); }
        .navbar a { color: #fff !important; }
        .hero { background: linear-gradient(135deg, #c0392b, #e74c3c); color: #fff; padding: 50px 0; text-align: center; }
        .hero h1 { font-weight: 800; font-size: 2.5rem; margin-bottom: 15px; }
        .hero p { font-size: 1.15rem; opacity: 0.9; margin-bottom: 0; }
        .section-title { font-weight: 800; color: #c0392b; margin-bottom: 24px; border-bottom: 3px solid #fdeaea; padding-bottom: 10px; }
        .card { border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); transition: all 0.3s; height: 100%; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 8px 25px rgba(0,0,0,0.12); }
        .card-body { padding: 20px; }
        .card-title { font-weight: 700; font-size: 1.05rem; color: #2c3e50; }
        .card-title a { color: #2c3e50; text-decoration: none; }
        .card-title a:hover { color: #c0392b; }
        .card-img-top { height: 200px; object-fit: cover; border-radius: 12px 12px 0 0; background: linear-gradient(135deg, #ffdab9, #ff6b6b); }
        .badge-resep { background: #c0392b; color: #fff; font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; }
        .sidebar-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); padding: 20px; margin-bottom: 20px; }
        .sidebar-card h5 { color: #c0392b; font-weight: 700; border-bottom: 2px solid #fdeaea; padding-bottom: 10px; margin-bottom: 15px; }
        .sidebar-card ul { list-style: none; padding: 0; }
        .sidebar-card ul li { padding: 8px 0; border-bottom: 1px solid #f5f5f5; }
        .sidebar-card ul li a { color: #555; text-decoration: none; transition: all 0.3s; display: block; }
        .sidebar-card ul li a:hover { color: #c0392b; padding-left: 5px; }
        footer { background: #222; color: #ccc; padding: 30px 0; margin-top: 40px; }
        footer a { color: #e74c3c; text-decoration: none; }
        footer a:hover { color: #fff; }
        .category-badge { display: inline-block; background: #fdeaea; color: #c0392b; padding: 2px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
        .card-text { font-size: 0.9rem; color: #777; margin-top: 8px; }
        @media (max-width: 768px) { .hero h1 { font-size: 1.8rem; } }
    </style>


